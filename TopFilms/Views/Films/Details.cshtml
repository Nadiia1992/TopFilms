@model TopFilms.Models.Film

@{
    ViewData["Title"] = "Деталі";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Деталі</h1>

<div class="cont-form">
    <h4>Фільм</h4>
    <hr />
    <div class="row">
        <div class="col-md-4 text-center">
            <img src="@Url.Content(Model.Poster)" alt="@Model.Name" class="delete-img" />
        </div>

        <div class="col-md-8">
            <h2>@Model.Name</h2>

            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Director)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Director)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Genre)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Genre)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Year)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Year)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Info)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Info)
                </dd>
            </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Редагувати</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Повернутися до списку</a>
</div>