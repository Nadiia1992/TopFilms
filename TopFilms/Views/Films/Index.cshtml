@model IEnumerable<TopFilms.Models.Film>
@{
    ViewData["Title"] = "Список студентів";
}

<div class="d-flex justify-content-between align-items-center mb-3">
   
    <a asp-action="Create" class="btn btn-success shadow-sm">+ Додати фільм</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">

                @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <img class="foto" src="@item.Poster"alt="@item.Name" />
                            <h2 class="align-middle">@Html.DisplayFor(modelItem => item.Name)</h2>
                            <h4 class="align-middle">@Html.DisplayFor(modelItem => item.Director)</h4>
                            <h5 class="align-middle">@Html.DisplayFor(modelItem => item.Genre)</h5>
                            <h4 class="align-middle">
                                <span class="badge bg-info text-dark fs-6">@Html.DisplayFor(modelItem => item.Year)</span>
                            </h4>
                            <p class="text-end align-middle">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Деталі</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                            </p>
                        </div>
                    </div>


                </div>
            }
            </div>
            </div>
            </div>