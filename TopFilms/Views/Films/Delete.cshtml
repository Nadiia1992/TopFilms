@model TopFilms.Models.Film

@{
    ViewData["Title"] = "Видалення";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Видалення</h1>

<h3 class="text-danger">Ви впевнені, що хочете видалити цей запис?</h3>
<div class="cont-form">
    <h4>Фільм</h4>
    <hr />
    <div class="row">
        <div class="col-md-4 text-center">
            <img src="@Url.Content(Model.Poster)" alt="@Model.Name" class="delete-img" />
                 </div>
   
        <div class="col-md-8">
            <h2>@Model.Name</h2>
          
            <dl class="row">          
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Director)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Director)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Genre)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Genre)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Year)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Year)
        </dd>
   
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Info)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Info)
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Повернутися до списку</a>
    </form>
</div>
</div>
</div>